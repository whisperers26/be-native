exports[`transmart translate > posts the text as JSON without credentials when username and token are empty 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": {
          "header": {
            "fn": "auto_translation",
          },
          "source": {
            "lang": "en",
            "text_list": [
              "hello",
            ],
          },
          "target": {
            "lang": "zh",
          },
          "type": "plain",
        },
        "type": "Json",
      },
      "method": "POST",
    },
    "url": "https://transmart.qq.com/api/imt",
  },
]
`;

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`deepl translate > api: uses api-free.deepl.com for :fx keys and sends the auth header 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": {
          "target_lang": "DE",
          "text": [
            "hello",
          ],
        },
        "type": "Json",
      },
      "headers": {
        "Authorization": "DeepL-Auth-Key k:fx",
        "Content-Type": "application/json",
      },
      "method": "POST",
    },
    "url": "https://api-free.deepl.com/v2/translate",
  },
]
`;

exports[`deepl translate > deeplx: posts to the custom URL and returns data 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": {
          "source_lang": "EN",
          "target_lang": "DE",
          "text": "hello",
        },
        "type": "Json",
      },
      "method": "POST",
    },
    "url": "http://localhost:1188/translate",
  },
]
`;

exports[`deepl translate > exports its info and language table 1`] = `
{
  "Language": {
    "auto": "auto",
    "de": "DE",
    "en": "EN",
    "es": "ES",
    "fr": "FR",

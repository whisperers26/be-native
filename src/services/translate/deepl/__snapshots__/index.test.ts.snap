exports[`deepl translate > free: cuts language codes to two letters and shifts the timestamp by the number of i in the text 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": "{"jsonrpc":"2.0","method": "LMT_handle_texts","params":{"splitting":"newlines","lang":{"source_lang_user_selected":"PT","target_lang":"PT"},"texts":[{"text":"hi","requestAlternatives":3}],"timestamp":1767323045680},"id":112345000}",
        "type": "Text",
      },
      "headers": {
        "Content-Type": "application/json",
      },
      "method": "POST",
    },
    "url": "https://www2.deepl.com/jsonrpc",
  },
]
`;

exports[`deepl translate > free: posts JSON-RPC to www2.deepl.com and returns the trimmed text 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": "{"jsonrpc":"2.0","method": "LMT_handle_texts","params":{"splitting":"newlines","lang":{"source_lang_user_selected":"EN","target_lang":"DE"},"texts":[{"text":"hello","requestAlternatives":3}],"timestamp":1767323045678},"id":112345000}",
        "type": "Text",
      },
      "headers": {
        "Content-Type": "application/json",
      },
      "method": "POST",
    },
    "url": "https://www2.deepl.com/jsonrpc",
  },
]
`;

exports[`yandex translate > posts a form with a uuid-based id in the query and returns the first text as it is 1`] = `
[
  {
    "options": {
      "body": Body {
        "payload": {
          "source_lang": "en",
          "target_lang": "de",
          "text": "hello world",
        },
        "type": "Form",
      },
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded",
      },
      "method": "POST",
      "query": {
        "id": "0123456789ab4cde8f0123456789abcd-0-0",
        "srv": "android",
      },
    },
    "url": "https://translate.yandex.net/api/v1/tr.json/translate",
  },
]
`;
